# SolarWise server-side AI provider settings ( Production on Vercel ).
# Copy to .env.local for local dev. NEVER commit real keys.
# The assistant works without these via the local fallback engine,
# but full AI replies + live decisions need them.

# OpenAI-compatible API key (server-only, never NEXT_PUBLIC_*)
CODEX_API_KEY=

# Base URL of the OpenAI-compatible provider, e.g. https://api.openai.com/v1
CODEX_API_URL=

# Model name, e.g. gpt-4o-mini
CODEX_MODEL=
